{
  "manifest_version": 3,
  "name": "FreeLife Handoff",
  "version": "0.1.0",
  "description": "Send tabs and links from your browser to your other FreeLife devices.",
  "action": {
    "default_title": "FreeLife Handoff",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["activeTab", "nativeMessaging"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+H"
      },
      "description": "Open the FreeLife device picker"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "handoff@freelife.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
