{
  "manifest_version": 3,
  "name": "FreeLife Handoff",
  "version": "0.1.0",
  "description": "Send tabs and links from your browser to your other FreeLife devices.",
  "action": {
    "default_title": "FreeLife Handoff",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "nativeMessaging"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+H"
      },
      "description": "Open the FreeLife device picker"
    }
  },
  "minimum_chrome_version": "122"
}
